<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SchoolAppCore (Razor Pages)</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; background: #f8fafc; color: #1e293b; }
        .navbar { background: #1e3a8a; padding: 14px 28px; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 2px 6px rgba(0,0,0,0.08); }
        .navbar-brand { color: #fff; font-size: 19px; font-weight: 700; text-decoration: none; margin-right: 28px; }
        .navbar-nav { list-style: none; display: flex; margin: 0; padding: 0; gap: 20px; }
        .nav-link { color: #e2e8f0; text-decoration: none; font-weight: 600; font-size: 14.5px; }
        .nav-link:hover { color: #fff; text-decoration: underline; }
        .container { max-width: 960px; margin: 28px auto; background: #fff; padding: 26px 32px; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
        h1, h2 { color: #1e3a8a; margin-top: 0; }
        table { width: 100%; border-collapse: collapse; margin-top: 16px; }
        th, td { border: 1px solid #cbd5e1; padding: 9px 14px; text-align: left; font-size: 14px; }
        th { background: #f1f5f9; font-weight: 700; color: #0f172a; }
        .btn { display: inline-block; background: #1e3a8a; color: #fff; padding: 7px 15px; border-radius: 5px; text-decoration: none; font-size: 13.5px; font-weight: 600; border: none; cursor: pointer; }
        .action-links a { color: #2563eb; text-decoration: none; margin-right: 8px; font-weight: 600; font-size: 13px; }
        .footer { max-width: 960px; margin: 12px auto 30px; color: #64748b; font-size: 13px; font-style: italic; text-align: center; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar">
            <div style="display:flex;align-items:center;">
                <a class="navbar-brand" asp-page="/Index">SchoolApp (ASP.NET Core Razor)</a>
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" asp-page="/Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Students/Index">Students</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Courses/Index">Courses</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Instructors/Index">Instructors</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Enrollments/Index">Enrollments</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Departments/Index">Departments</a></li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>
    <footer class="footer">
        Developed by L&#234; Ho&#224;ng Tr&#237; - 524H0199 | SE Lab 7 - ASP.NET Core Razor Pages (DB First Approach)
    </footer>
</body>
</html>
