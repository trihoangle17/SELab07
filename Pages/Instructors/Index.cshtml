@page
@model SchoolAppCore.Pages.Instructors.IndexModel
@{
    ViewData["Title"] = "Instructors";
}

<h2>Instructors List (ASP.NET Core Razor Pages - CRUD)</h2>
<p><a class="btn" asp-page="Create">+ Create New Instructor</a></p>
<table>
    <thead>
        <tr>
            <th>InstructorID</th>
            <th>FirstName</th>
            <th>LastName</th>
            <th>HireDate</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Instructors) {
        <tr>
            <td>@item.InstructorID</td>
            <td>@item.FirstName</td>
            <td>@item.LastName</td>
            <td>@item.HireDate.ToString("yyyy-MM-dd")</td>
            <td class="action-links">
                <a href="#">Edit</a> | <a href="#">Details</a> | <a href="#">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
