@page
@model SchoolAppCore.Pages.Courses.IndexModel
@{
    ViewData["Title"] = "Courses";
}

<h2>Courses List (ASP.NET Core Razor Pages - CRUD)</h2>
<p><a class="btn" asp-page="Create">+ Create New Course</a></p>
<table>
    <thead>
        <tr>
            <th>CourseID</th>
            <th>Title</th>
            <th>Credits</th>
            <th>Department</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Courses) {
        <tr>
            <td>@item.CourseID</td>
            <td>@item.Title</td>
            <td>@item.Credits</td>
            <td>@(item.Department?.Name ?? item.DepartmentID.ToString())</td>
            <td class="action-links">
                <a href="#">Edit</a> | <a href="#">Details</a> | <a href="#">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
